# Self-hosted webfonts. The filename encodes family, weight and subset, so a
# given URL can never change contents — a new face would be a new file. Without
# this they inherited the site default of 4 hours + must-revalidate, which costs
# a conditional request on every repeat visit for a file that is already correct.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/components/*
  X-Robots-Tag: noindex, nofollow

/_data/*
  X-Robots-Tag: noindex, nofollow

/assets/data/*
  X-Robots-Tag: noindex, follow

# The pricing catalog and the versioned price tables. Machine surfaces, not pages: the CRM's
# cross-repository drift cron reads /pricing/catalog/index.json and compares the sha256 of the
# live catalog against its own pinned literal, and an old lead is verified against
# /pricing/price-tables/<the version it carries>.json. Kept out of the index, and CORS-open
# because the reader is on another origin (crm.asap.repair).
/pricing/*
  X-Robots-Tag: noindex, nofollow
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

